{
  "ci": {
    "collect": {
      "startServerCommand": "npm run start -- --port 3125",
      "url": [
        "http://127.0.0.1:3125/",
        "http://127.0.0.1:3125/lab/a",
        "http://127.0.0.1:3125/lab/c"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 1 }],
        "categories:seo": ["error", { "minScore": 0.6 }],
        "is-crawlable": "off"
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
