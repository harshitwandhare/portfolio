# Contact form. Both are needed before /api/contact will send; with either one
# missing the endpoint returns 503 and the form falls back to opening the
# visitor's own mail client, which is a working path rather than an error.
#
# RESEND_API_KEY  an API key from https://resend.com
# CONTACT_FROM    a sender on a domain verified in that Resend account.
#                 It cannot be a gmail.com or utdallas.edu address: Resend will
#                 refuse to send from a domain it does not hold DKIM for.
RESEND_API_KEY=
CONTACT_FROM=Portfolio <contact@harshitwandhare.com>
